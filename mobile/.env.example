# Copy to .env and fill in. Expo only exposes EXPO_PUBLIC_* vars to the
# client bundle — same convention as Next.js's NEXT_PUBLIC_*. The anon key
# is safe to ship client-side by design (RLS is the real access control).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL for the app/api/mobile/* Route Handlers (see ../app/api/mobile/).
# - iOS Simulator: http://localhost:3000 works
# - Android Emulator: use http://10.0.2.2:3000 instead (it can't reach
#   "localhost" — that resolves to the emulator itself, not the host machine)
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.x:3000
# - Production: your deployed Next.js URL, once hosting is chosen (still open)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
