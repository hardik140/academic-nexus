# ============================================
# Academic Nexus — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (server-side only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Gate pass QR signing — REQUIRED before any gate pass can be issued or
# scanned. Signs the credential payload the student presents at the gate.
#
#   generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# 32 characters minimum. There is deliberately no development fallback: a
# fallback key is a key an attacker also has, so an unset key means no QR
# renders and no scan verifies rather than a weakly-signed one that does.
# Rotating it invalidates every QR currently in a student's hand — the
# stored credentials stay ACTIVE and re-render correctly under the new key
# the next time the student opens the pass, but a screenshot taken before
# the rotation stops scanning. Rotate between terms, not mid-day.
GATE_QR_SIGNING_KEY=

# Upstash Redis — rate limiting (lib/rate-limit.ts) and caching (lib/cache.ts).
# Unset outside production: rate limiting is off and reads are uncached.
# Unset IN production: high-risk and unclassified actions are refused (503),
# only the documented low-risk buckets run (lib/rate-limit-policy.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Which environment's keys this process uses: production | preview | staging |
# development | test | e2e. Every key is prefixed `<env>:nexus:`. Unset, a
# built bundle uses `production` and `next dev` uses `development`. Set it to
# `development` here if you ever run `next start` locally against a shared
# Upstash database. The production namespace is refused outside a production
# build (lib/redis-config.ts).
REDIS_ENV=development
# Longest one Redis call may take, retries included (default 1000, 100–5000).
# REDIS_TIMEOUT_MS=1000
# Fraction of successful Redis events written to the log (default 0.01).
# Failures are always written.
# REDIS_LOG_SAMPLE_RATE=0.01

# QStash — signed scheduled jobs. /api/cron/expire-gate-credentials refuses
# every request with 503 unless both signing keys are present, so an
# unsigned caller can never reach the expiry function. Nothing breaks in
# gate security if the schedule never runs: an out-of-window credential is
# refused at scan time by its own expires_at check, and this job only keeps
# the stored status honest for the dashboards.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Academic Nexus

# Sentry (optional — error tracking no-ops until these are set; OBSERVABILITY.md)
# Browser reports: NEXT_PUBLIC_SENTRY_DSN must be set at BUILD time (it is inlined).
NEXT_PUBLIC_SENTRY_DSN=
# Server reports (instrumentation.ts): a Worker secret, read at runtime.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source-map upload during an ENABLE_SENTRY=true build (project:releases scope).
SENTRY_AUTH_TOKEN=
# System Health page: an auth token with the event:read scope ONLY. Server-side.
SENTRY_READ_TOKEN=
# Optional: https://de.sentry.io for an EU-region organisation.
SENTRY_API_URL=

# SMTP (nodemailer) — invitation and password-reset emails. Nothing sends
# until all four are set; see lib/email.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Super Admin bootstrap credentials — optional, read once by
# `npm run bootstrap-super-admin` (falls back to interactive prompts if
# unset, which is the safer default outside local dev). Delete after
# running it once.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=
SUPER_ADMIN_PASSWORD=

# Finance integration hub — encrypts third-party accounting credentials
# (Tally / BUSY / Zoho) with AES-256-GCM before they reach the database.
# 32 bytes, base64. Generate with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# lib/finance/crypto.ts FAILS CLOSED without it — a connection cannot be
# created rather than storing a credential under anything weaker. There is no
# KMS, Vault or HSM in this repository, which is recorded as a production
# blocker for this feature in DEPLOYMENT_VERIFICATION.md rather than papered
# over.
FINANCE_CREDENTIAL_KEY=
