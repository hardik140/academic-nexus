# ============================================
# Academic Nexus — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (server-side only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Academic Nexus

# Sentry (optional — error tracking no-ops until these are set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# SMTP (nodemailer) — invitation and password-reset emails. Nothing sends
# until all four are set; see lib/email.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Super Admin bootstrap credentials — optional, read once by
# `npm run bootstrap-super-admin` (falls back to interactive prompts if
# unset, which is the safer default outside local dev). Delete after
# running it once.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=
SUPER_ADMIN_PASSWORD=
